# MindLoom Environment Variables Example

# ─── Database ─────────────────────────────────────
# Your MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/mindloom

# ─── Auth & Security ──────────────────────────────
# Generate a secure 32+ byte string for encrypting cookies and API keys
# e.g., run: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=YOUR_SECURE_GENERATED_SECRET_HERE

# ─── Next.js ──────────────────────────────────────
# The public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── ML Service ───────────────────────────────────
# URL of the local Python ML service
ML_SERVICE_URL=http://localhost:8000
# Must match the API key expected by the Python backend
ML_SERVICE_API_KEY=mindloom-dev-secret

# ─── External AI ──────────────────────────────────
# Default Gemini API Key (optional if users provide their own via BYOK)
GEMINI_API_KEY=your_gemini_api_key_here
